[Unit]
Description=Heimdall chat router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
UMask=0077
# Config uses API origin (without /bot), and file prefix (with /file/bot).
Environment=HEIMDALL_TELEGRAM_API_BASE=http://127.0.0.1:8081
Environment=HEIMDALL_TELEGRAM_FILE_BASE=http://127.0.0.1:8081/file/bot
Environment=HEIMDALL_TELEGRAM_MAX_FILE_BYTES=2000000000
ExecStart=/usr/local/sbin/heimdall-infisical-run.sh /usr/local/sbin/heimdall-run.sh
Restart=on-failure
RestartSec=5s
# Native exit grace 60s + TERM grace 5s + pipe wait 5s; allow delivery drain.
TimeoutStopSec=180s
KillMode=control-group
# Limits cover Heimdall and every harness process it starts (one cgroup).
# Size them to the host: MemoryHigh well above the normal working set
# (throttles and reclaims first), MemoryMax below what the host can spare
# beside its other services. OOMPolicy=continue: an OOM-killed harness
# child fails only its own turn instead of stopping the whole unit.
MemoryHigh=6G
MemoryMax=7G
TasksMax=4096
OOMPolicy=continue
StandardOutput=journal
StandardError=journal
SyslogIdentifier=heimdall

# Deliberately no [Install] section: shipped disabled, manual activation only.
